// Move the left paddle with the mouse
game.addEventListener('mousemove', (e) => {
  const rect = game.getBoundingClientRect();
  leftPaddleY = e.clientY - rect.top - paddleHeight / 2;
  leftPaddleY = Math.max(0, Math.min(gameHeight - paddleHeight, leftPaddleY));
  leftPaddle.style.top = `${leftPaddleY}px`;
});

// Control the left paddle with arrow keys
document.addEventListener('keydown', (e) => {
  if (e.key === 'ArrowUp') {
    leftPaddleY = Math.max(0, leftPaddleY - paddleSpeed);
  } else if (e.key === 'ArrowDown') {
    leftPaddleY = Math.min(gameHeight - paddleHeight, leftPaddleY + paddleSpeed);
  }
  leftPaddle.style.top = `${leftPaddleY}px`;
});

